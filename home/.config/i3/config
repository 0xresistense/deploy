#####################
# i3 config file (v4)
#####################
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

###################
# Variables
###################
set $mod Mod4
set $alt Mod1

# Workspace names with icons
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
# Right-monitor workspaces (DP-0)
set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"
set $ws15 "15"
set $ws16 "16"
set $ws17 "17"
set $ws18 "18"
set $ws19 "19"
set $ws20 "20"

# Colors
set $bg-color            #2f343f
set $inactive-bg-color   #2f343f
set $text-color          #f3f4f5
set $inactive-text-color #676E7D
set $urgent-bg-color     #E53935
set $black #000000
set $dark #0f0f0f
set $disabled #504945
set $red #ea6962
set $red-alt #b22222
set $orange #fe8019
set $orange-mat #e78a4e
set $yellow #fabd2f
set $yellow-mat #d8a657
set $green #b8bb26
set $aqua #8ec07c
set $blue #458588
set $blue-alt #83a598
set $grey #504945
set $dark-grey #1d2021
set $cream #ebdbb2
set $white #FFFFFF
set $transparent #00000000
set $Stransparent #CC000000
set $sky600 #0284c7
set $sky400 #38bdf8
set $green600 #16a34a

###################
# Basic Settings
###################
font pango:JetBrainsMono Nerd Font 8

# Window Colors
# client.focused            $sky400           $sky600          $text-color           #00ff00
# client.unfocused        $inactive-bg-color  $inactive-bg-color  $inactive-text-color  #00ff00
# client.focused_inactive $inactive-bg-color  $inactive-bg-color  $inactive-text-color  #00ff00
# client.urgent           $urgent-bg-color    $urgent-bg-color    $text-color           #00ff00


# Gaps and Borders
gaps inner 0
gaps outer 0
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 1


###################
# Startup Applications
###################
# System
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xset +dpms dpms 0 0 0   # DPMS on (so manual `xset dpms force off` + xsecurelock blanking work) but NO auto timeout
# tray applets removed — replaced by keybinds (see App menus below). Tray-less: GTK3 XEMBED icons can't scale below 16px.
# exec --no-startup-id blueman-applet   # -> $mod+b blueman-manager
# notifications: deadd-notification-center (systemd --user managed, replaced dunst)
# clipmenud MUST launch from i3 (DISPLAY is set here), NOT the systemd --user service:
# that unit starts pre-X at default.target, DISPLAY is unset -> exits status 2 -> dies.
# wrapper kills clipmenud when X dies (else it spins printing xsel errors at logout)
exec --no-startup-id __HOME__/.local/bin/clipmenud-guarded
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id lxpolkit
# exec --no-startup-id nm-applet        # -> $mod+n nm-connection-editor
# exec --no-startup-id python3 ~/.local/share/scripts/protonvpn-tray.py  # -> $mod+Shift+v vpn-menu
# warm claude-mem worker at login so the first Claude Code session is clean
exec --no-startup-id ~/.local/share/scripts/claude-mem-warm.sh
# exec --no-startup-id simplescreenrecorder --start-hidden
# exec --no-startup-id aw-qt --no-gui

# exec --no-startup-id pasystray        # -> $mod+p pavucontrol

# Display layout (both monitors, rates, tear-free) is owned solely by ~/.xprofile
# via a single nvidia CurrentMetaMode. i3 does not run xrandr — avoids conflicting
# duplicate layout commands. Workspace->output pinning lives in Workspace Management.


# pipewire/wireplumber/pipewire-pulse are systemd --user managed on Arch (socket-activated);
# manually execing them here conflicted with the systemd units and broke pipewire-pulse.

# XFCE Utilities
# exec --no-startup-id xfsettingsd
# Clipboard history = clipmenud (record-only), launched from i3 above ($mod+c = rofi recall).
# Replaced xfce4-clipman, which SEIZED live CLIPBOARD ownership and broke Alacritty copy
# ("Failed to set new owner of XCB selection"). clipmenu is record-only, so it never fights.
exec --no-startup-id xfce4-power-manager --sm-client-disable --daemon
exec --no-startup-id /usr/libexec/xfce-polkit


# bindsym $mod+Shift+t exec --no-startup-id "transset-df -a --min 0.6 --dec 0.1"
# bindsym $mod+t exec --no-startup-id "transset-df -a --min 0.6 --inc 0.1"

# Aesthetics
exec --no-startup-id feh --bg-scale __HOME__/.local/share/wallpapers/bg-c-1.png
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

###################
# Audio Controls
###################
set $refresh_i3status killall -SIGUSR1 i3status

# Pipewire controls
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle &&$refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $refresh_i3status
bindsym XF86AudioPlay exec playerctl play
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Knob modifiers
# Shift + knob = scroll the focused window (clears Shift so it's vertical, not horizontal)
bindsym Shift+XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/knob-scroll.sh up
bindsym Shift+XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/knob-scroll.sh down
# Mod + knob = monitor brightness (DDC/CI hardware, both displays)
bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/brightness.sh up
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/brightness.sh down
# Mod + Shift + knob = screen warmth (color temperature, redshift RandR gamma)
bindsym $mod+Shift+XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/warmth.sh up
bindsym $mod+Shift+XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/warmth.sh down
# Ctrl + knob = zoom the focused window (Ctrl+scroll: pages, PDFs, images, editors)
bindsym Control+XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/knob-zoom.sh in
bindsym Control+XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/knob-zoom.sh out

# Mod + Shift + w = toggle screen warmth on/off
bindsym $mod+Shift+w exec --no-startup-id ~/.config/i3/scripts/warmth.sh toggle

###################
# Window Management
###################
floating_modifier $alt
tiling_drag modifier titlebar
# focus_follows_mouse no
# Dual-monitor: warp the cursor to a window's output when focus crosses monitors
# (this is i3's default — set explicitly to make the dual-head intent clear).
mouse_warping output


# Window Rules
for_window [class="pavucontrol"] floating enable, move position center
for_window [title="^Bitwarden$"] floating enable, move position center
for_window [instance="^crx_nngceckbapebfimnlniiiahkandclblb$"] floating enable, move position center
for_window [class="flameshot"] floating enable, move position center
for_window [class="Nm-connection-editor"] floating enable, move position center
for_window [class="feh"] floating enable, move position center
for_window [class="Blueman-manager"] floating enable, move position center
for_window [class="Bitwarden"] floating enable, move position center
# for_window [class="xfce4-panel"] floating enable
for_window [class="Gpick"] floating enable, move position center
for_window [class="Device Manager"] floating enable, move position center
for_window [class="Emulator"] floating enable, move position center
for_window [class="SimpleScreenRecorder"] floating enable, move position center
for_window [class="Protonvpn-app"] floating enable, move position center
for_window [class="Xfce4-clipman-history"] floating enable, move position center

# Window Navigation
bindsym $alt+h focus left
bindsym $alt+j focus down
bindsym $alt+k focus up
bindsym $alt+l focus right
bindsym $alt+Left focus left
bindsym $alt+Down focus down
bindsym $alt+Up focus up
bindsym $alt+Right focus right

# Window Movement
bindsym $alt+Shift+h move left
bindsym $alt+Shift+j move down
bindsym $alt+Shift+k move up
bindsym $alt+Shift+l move right
bindsym $alt+Shift+Left move left
bindsym $alt+Shift+Down move down
bindsym $alt+Shift+Up move up
bindsym $alt+Shift+Right move right

# Window Layout Controls
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $alt+f fullscreen toggle
bindsym $alt+s layout stacking
bindsym $alt+w layout tabbed
bindsym $alt+e layout toggle split
bindsym $alt+Shift+space floating toggle
bindsym $alt+space focus mode_toggle
bindsym $alt+a focus parent

# Scratchpad (tray replacement for background apps like Bitwarden/Telegram):
# $mod+Shift+minus stashes the focused window (keeps running, hidden);
# $mod+minus summons it floating / hides it again (cycles if several stashed).
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Sticky: pin the focused window so it follows you across every workspace
# (floats it first if tiled, then toggles sticky on/off). Great for PiP/notes.
bindsym $mod+y floating enable, sticky toggle

# i3-input — interactive text prompts:
#   $mod+r        rename the current workspace
#   $mod+g        tag the focused window with a mark, then...
#   $mod+Shift+g  jump to a window by its mark
bindsym $mod+r exec i3-input -F 'rename workspace to "%s"' -P 'rename ws: '
bindsym $mod+g exec i3-input -F 'mark %s' -P 'mark: '
bindsym $mod+Shift+g exec i3-input -F '[con_mark="%s"] focus' -P 'goto mark: '

###################
# Workspace Management
###################
# Workspace Switching
bindsym $alt+1 workspace number $ws1
bindsym $alt+2 workspace number $ws2
bindsym $alt+3 workspace number $ws3
bindsym $alt+4 workspace number $ws4
bindsym $alt+5 workspace number $ws5
bindsym $alt+6 workspace number $ws6
bindsym $alt+7 workspace number $ws7
bindsym $alt+8 workspace number $ws8
bindsym $alt+9 workspace number $ws9
bindsym $alt+0 workspace number $ws10
# Right monitor (DP-0): F1..F10 -> workspaces 11..20
bindsym $alt+F1 workspace number $ws11
bindsym $alt+F2 workspace number $ws12
bindsym $alt+F3 workspace number $ws13
bindsym $alt+F4 workspace number $ws14
bindsym $alt+F5 workspace number $ws15
bindsym $alt+F6 workspace number $ws16
bindsym $alt+F7 workspace number $ws17
bindsym $alt+F8 workspace number $ws18
bindsym $alt+F9 workspace number $ws19
bindsym $alt+F10 workspace number $ws20

# Move Container to Workspace
bindsym $alt+Shift+1 move container to workspace number $ws1
bindsym $alt+Shift+2 move container to workspace number $ws2
bindsym $alt+Shift+3 move container to workspace number $ws3
bindsym $alt+Shift+4 move container to workspace number $ws4
bindsym $alt+Shift+5 move container to workspace number $ws5
bindsym $alt+Shift+6 move container to workspace number $ws6
bindsym $alt+Shift+7 move container to workspace number $ws7
bindsym $alt+Shift+8 move container to workspace number $ws8
bindsym $alt+Shift+9 move container to workspace number $ws9
bindsym $alt+Shift+0 move container to workspace number $ws10
# Right monitor (DP-0): move container to workspaces 11..20
bindsym $alt+Shift+F1 move container to workspace number $ws11
bindsym $alt+Shift+F2 move container to workspace number $ws12
bindsym $alt+Shift+F3 move container to workspace number $ws13
bindsym $alt+Shift+F4 move container to workspace number $ws14
bindsym $alt+Shift+F5 move container to workspace number $ws15
bindsym $alt+Shift+F6 move container to workspace number $ws16
bindsym $alt+Shift+F7 move container to workspace number $ws17
bindsym $alt+Shift+F8 move container to workspace number $ws18
bindsym $alt+Shift+F9 move container to workspace number $ws19
bindsym $alt+Shift+F10 move container to workspace number $ws20

# Output assignment — pin each workspace set to its monitor
# Left/primary = HDMI-0 (ws 1-10), Right/secondary = DP-0 (ws 11-20)
workspace $ws1 output HDMI-0
workspace $ws2 output HDMI-0
workspace $ws3 output HDMI-0
workspace $ws4 output HDMI-0
workspace $ws5 output HDMI-0
workspace $ws6 output HDMI-0
workspace $ws7 output HDMI-0
workspace $ws8 output HDMI-0
workspace $ws9 output HDMI-0
workspace $ws10 output HDMI-0
workspace $ws11 output DP-0
workspace $ws12 output DP-0
workspace $ws13 output DP-0
workspace $ws14 output DP-0
workspace $ws15 output DP-0
workspace $ws16 output DP-0
workspace $ws17 output DP-0
workspace $ws18 output DP-0
workspace $ws19 output DP-0
workspace $ws20 output DP-0

# Workspace assignments
assign [class="SimpleScreenRecorder"] $ws8

###################
# Application Shortcuts
###################
bindsym $alt+Return exec i3-sensible-terminal
# bindsym $mod+Return exec NO_TMUX=1 alacritty
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+1 exec thunar
bindsym $mod+2 exec librewolf -P personal
bindsym $mod+Shift+2 exec firefox --private-window
bindsym $mod+3 exec brave
bindsym $mod+4 exec chromium
bindsym $alt+q kill
bindsym $mod+Ctrl+Escape xkill
bindsym $mod+p exec --no-startup-id ~/.local/share/scripts/audio-menu
# App menus (replaced the system tray)
bindsym $mod+n exec --no-startup-id ~/.local/share/scripts/net-menu
bindsym $mod+b exec --no-startup-id blueman-manager
bindsym $mod+c exec --no-startup-id "CM_LAUNCHER=rofi clipmenu"
bindsym $mod+i exec --no-startup-id ~/.local/share/scripts/vpn-menu
bindsym $mod+t exec --no-startup-id ~/.local/share/scripts/timer-alarm menu
bindsym Print exec ~/.local/share/scripts/screenshot
bindsym $mod+s exec flameshot full
bindsym $mod+Shift+s exec flameshot gui
bindsym $mod+period exec "rofimoji --action copy --clipboarder xclip"
bindsym $mod+u exec ~/.local/share/scripts/unicode-select

bindsym F8 exec alacritty -e ranger
# F9 = stopwatch start/pause/resume; F10 = kill a buzzing alarm/timer (priority), else reset stopwatch
bindsym F9 exec --no-startup-id ~/.local/share/scripts/timer-alarm sw-toggle
bindsym F10 exec --no-startup-id ~/.local/share/scripts/timer-alarm sw-reset





###################
# System Controls
###################
# i3 Management
bindsym $alt+Shift+c reload
bindsym $alt+Shift+r restart
# bindsym $alt+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
# bindsym $alt+Shift+e exec ~/.local/share/scripts/powermenu
# Lock Screen
set $Locker ~/.local/share/scripts/blur-lock
bindsym $mod+l exec --no-startup-id $Locker
# Pick color and copy to clipboard
bindsym $mod+Shift+p exec gpick -p -o

set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown, (b) off-screen

mode "$mode_system" {
    bindsym l exec --no-startup-id $Locker, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id "$Locker && systemctl suspend", mode "default"
    bindsym h exec --no-startup-id "$Locker && systemctl hibernate", mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym b exec --no-startup-id sleep 1 && xset dpms force off, mode "default"
    bindsym Shift+s exec --no-startup-id systemctl poweroff -i, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $alt+Shift+e mode "$mode_system"


###################
# Resize Mode
###################
bindsym $alt+r mode "resize"
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $alt+r mode "default"
}
