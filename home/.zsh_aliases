# alias
alias c="clear"
alias cd..="cd .."
alias curl="curl --user-agent 'noleak'"
alias l="lsd -1 --color=auto"
alias la="lsd -ah --color=auto"
alias ll="lsd -ahl --color=auto"
alias r="reset"
alias shred="shred -zf"
alias sl="lsd --color=auto"
alias vi="nvim"
alias ls="lsd --color=auto"
alias dir="dir --color=auto"
alias vdir="vdir --color=auto"
alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"
alias wget="wget -c --user-agent 'noleak'"
alias dd="dd status=progress"
alias cp="cp -i"                          # confirm before overwriting something
alias rm="rm -i"
alias mv="mv -i"
alias df="df -h"                          # human-readable sizes
alias free="free -h"
alias du="du -h"
alias gwen="gwenview"
alias ff="fastfetch"
alias pm="podman"
alias .2="watch --interval=.2"
alias gpp="git switch prod; git merge dev; git push; git switch dev; git push"
alias brd="bun run dev"
alias trd="turbo run dev"
alias copy="xclip -selection clipboard"
# alias code="vscodium"
alias open="xdg-open"
alias th="thunar"
alias clp='CLAUDE_CONFIG_DIR=~/.claude-personal claude'
alias oc="opencode"
alias tmuxn="tmux new-session -s"
alias snap.send='COOL_BATT=40 COOL_MAX=300 __HOME__/Workspace/user/bin/send_snaps.sh -x -t -p 150:45 -c 10000'
alias snap.open='__HOME__/Workspace/user/bin/open_snaps.sh'
